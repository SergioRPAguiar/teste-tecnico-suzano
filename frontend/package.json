{
  "name": "suzano-case-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:visual:docker": "node scripts/browser-tests.cjs",
    "test:visual:docker:update": "node scripts/browser-tests.cjs --update-snapshots",
    "test:real:docker": "node scripts/browser-tests.cjs --real"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15",
    "msw": "2.12.1"
  },
  "overrides": {
    "js-yaml@^3.13.1": "4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/jest": "30.0.0",
    "@playwright/test": "1.64.1",
    "jest": "30.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
