{
  "name": "suzano-case-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:e2e": "node test/run-e2e.cjs",
    "db:validate": "node scripts/prisma.cjs validate",
    "db:format": "node scripts/prisma.cjs format",
    "db:generate": "node scripts/prisma.cjs generate",
    "db:migrate": "node scripts/prisma.cjs migrate dev",
    "db:deploy": "node scripts/prisma.cjs migrate deploy",
    "db:status": "node scripts/prisma.cjs migrate status",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/jwt": "11.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "js-yaml@^3.13.1": "4.3.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "pg": "8.23.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
